# api
API_PORT_HOST=8000
API_PORT_CONTAINER=8000

# pgadmin
PGADMIN_PORT_HOST=5050
PGADMIN_PORT_CONTAINER=80
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-please

# postgres
POSTGRES_HOST=postgres
POSTGRES_PORT_HOST=5432
POSTGRES_PORT_CONTAINER=5432
POSTGRES_USER=dungeon
POSTGRES_PASSWORD=dungeon
POSTGRES_DB=dungeon
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT_CONTAINER}/${POSTGRES_DB}"

# redis
REDIS_HOST=redis
REDIS_PORT_HOST=6379
REDIS_PORT_CONTAINER=6379
REDIS_URL="redis://${REDIS_HOST}:${REDIS_PORT_CONTAINER}"
